@echo off
chcp 65001 >nul
rem ===================================================================
rem  野狐自动对弈 · 启动器
rem -------------------------------------------------------------------
rem  为什么用 py -3.14 而不是 .workbuddy 里那个 python：
rem    内置的 3.13.12 是精简版，**没有 tkinter**，GUI 起不来。
rem    系统里的 3.14.7 带 Tk 9.0，numpy/mss/pillow 也装好了。
rem ===================================================================
setlocal
cd /d "%~dp0"

py -3.14 "%~dp0gui.py" %*
if errorlevel 1 (
    echo.
    echo [启动失败] 看看上面的报错。
    echo 如果提示 py 不存在，改成 python gui.py 试试。
    pause
)
